# Локально: `npm run db:up` підіймає Postgres із docker-compose.yml на 5433.
# На Railway цю змінну дає плагін Postgres — посилайся на неї як
# ${{Postgres.DATABASE_URL}}, щоб ходити приватною мережею.
DATABASE_URL=postgres://malecha:malecha_local@localhost:5433/malecha

# Підпис JWT-сесій. Обов'язкова, без неї вхід не працює.
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Публічна адреса застосунку. На Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXTAUTH_URL=http://localhost:3000

# Аварійний вимикач: 1 — не накочувати міграції на старті сервера.
# SKIP_DB_MIGRATIONS=0

# Перший власник на свіжій базі. Спрацьовує лише поки користувачів немає
# жодного; після першого запуску змінні варто прибрати.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_KINDERGARTEN_NAME=Малеча

# Супер-адміністратор кабінету /admin. Заводиться, лише поки жодного немає —
# на відміну від власника, перевіряється не порожнеча таблиці, а відсутність
# саме цієї ролі. Після першого запуску змінні варто прибрати.
# BOOTSTRAP_SUPERADMIN_EMAIL=
# BOOTSTRAP_SUPERADMIN_PASSWORD=
# BOOTSTRAP_SUPERADMIN_NAME=

# Пошта для листів про пароль. SMTP, а не API конкретного сервісу — одна
# змінна покриває Resend, Postmark і скриньку на власному домені.
# Якщо не задано, лист не зникає: посилання друкується в лог сервера.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Малеча <no-reply@example.com>
